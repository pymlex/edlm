  "docusaurus-plugin-redoc": {
    "openapi": {
      "url": "redocusaurus\\openapi.yaml",
      "themeId": "theme-redoc",
      "isSpecFile": true,
      "normalizeUrl": true,
      "spec": {
        "openapi": "3.1.0",
        "info": {
          "title": "Course Platform API",
          "version": "1.0.0"
        },
        "servers": [
          {
            "url": "https://api.example.com"
          }
        ],
        "paths": {
          "/courses/search": {
            "post": {
              "summary": "Поиск и фильтрация курсов",
              "operationId": "searchCourses",
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/CourseSearchRequest"
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Список курсов",
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/CourseSearchResponse"
                      }
                    }
                  }
                }
              }
            }
          },
          "/courses/{courseId}": {
            "get": {
              "summary": "Получить курс по id",
              "operationId": "getCourseById",
              "parameters": [
                {
                  "name": "courseId",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              ],
              "responses": {
                "200": {
                  "description": "Курс",
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/CourseDetail"
                      }
                    }
                  }
                }
              }
            }
          },
          "/courses/{courseId}/reviews": {
            "get": {
              "summary": "Получить отзывы курса",
              "operationId": "getCourseReviews",
              "parameters": [
                {
                  "name": "courseId",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              ],
              "responses": {
                "200": {
                  "description": "Отзывы",
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/ReviewListResponse"
                      }
                    }
                  }
                }
              }
            },
            "post": {
              "summary": "Создать отзыв",
              "operationId": "createCourseReview",
              "parameters": [
                {
                  "name": "courseId",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              ],
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/CreateReviewRequest"
                    }
                  }
                }
              },
              "responses": {
                "201": {
                  "description": "Отзыв создан",
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/Review"
                      }
                    }
                  }
                }
              }
            }
          },
          "/enrollments": {
            "post": {
              "summary": "Записаться на курс",
              "operationId": "createEnrollment",
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/CreateEnrollmentRequest"
                    }
                  }
                }
              },
              "responses": {
                "201": {
                  "description": "Запись создана",
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/Enrollment"
                      }
                    }
                  }
                }
              }
            }
          },
          "/courses/{courseId}/drafts": {
            "post": {
              "summary": "Создать черновик курса",
              "operationId": "createDraft",
              "parameters": [
                {
                  "name": "courseId",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              ],
              "requestBody": {
                "required": false,
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/CreateDraftRequest"
                    }
                  }
                }
              },
              "responses": {
                "201": {
                  "description": "Черновик создан",
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/DraftSummary"
                      }
                    }
                  }
                }
              }
            }
          },
          "/courses/{courseId}/drafts/{draftId}": {
            "get": {
              "summary": "Получить черновик",
              "operationId": "getDraftById",
              "parameters": [
                {
                  "name": "courseId",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                {
                  "name": "draftId",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              ],
              "responses": {
                "200": {
                  "description": "Черновик",
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/DraftDetail"
                      }
                    }
                  }
                }
              }
            },
            "patch": {
              "summary": "Обновить черновик",
              "operationId": "updateDraft",
              "parameters": [
                {
                  "name": "courseId",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                {
                  "name": "draftId",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              ],
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/UpdateDraftRequest"
                    }
                  }
                }
              },
              "responses": {
                "204": {
                  "description": "Черновик обновлён"
                }
              }
            }
          },
          "/courses/{courseId}/drafts/{draftId}/materials": {
            "post": {
              "summary": "Загрузить материал",
              "operationId": "uploadDraftMaterial",
              "parameters": [
                {
                  "name": "courseId",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                {
                  "name": "draftId",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              ],
              "requestBody": {
                "required": true,
                "content": {
                  "multipart/form-data": {
                    "schema": {
                      "$ref": "#/components/schemas/UploadMaterialRequest"
                    }
                  }
                }
              },
              "responses": {
                "201": {
                  "description": "Материал загружен",
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/Material"
                      }
                    }
                  }
                }
              }
            }
          },
          "/courses/{courseId}/drafts/{draftId}/generate": {
            "post": {
              "summary": "Сгенерировать содержимое",
              "operationId": "generateDraftContent",
              "parameters": [
                {
                  "name": "courseId",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                {
                  "name": "draftId",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              ],
              "requestBody": {
                "required": true,
                "content": {
                  "application/json": {
                    "schema": {
                      "$ref": "#/components/schemas/GenerateDraftRequest"
                    }
                  }
                }
              },
              "responses": {
                "200": {
                  "description": "Содержимое сгенерировано",
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/GenerateDraftResponse"
                      }
                    }
                  }
                }
              }
            }
          },
          "/courses/{courseId}/drafts/{draftId}/publish": {
            "post": {
              "summary": "Опубликовать черновик",
              "operationId": "publishDraft",
              "parameters": [
                {
                  "name": "courseId",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                {
                  "name": "draftId",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              ],
              "responses": {
                "200": {
                  "description": "Черновик опубликован",
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/PublishDraftResponse"
                      }
                    }
                  }
                }
              }
            }
          },
          "/courses/{courseId}/drafts/{draftId}/history": {
            "get": {
              "summary": "История черновика",
              "operationId": "getDraftHistory",
              "parameters": [
                {
                  "name": "courseId",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "format": "uuid"
                  }
                },
                {
                  "name": "draftId",
                  "in": "path",
                  "required": true,
                  "schema": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              ],
              "responses": {
                "200": {
                  "description": "История",
                  "content": {
                    "application/json": {
                      "schema": {
                        "$ref": "#/components/schemas/DraftHistoryGraph"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "components": {
          "schemas": {
            "CourseSearchRequest": {
              "type": "object",
              "required": [
                "query",
                "page",
                "pageSize"
              ],
              "properties": {
                "query": {
                  "type": "string"
                },
                "page": {
                  "type": "integer"
                },
                "pageSize": {
                  "type": "integer"
                },
                "sortBy": {
                  "type": "string",
                  "enum": [
                    "relevance",
                    "rating_desc",
                    "price_asc",
                    "price_desc",
                    "newest"
                  ]
                }
              }
            },
            "CourseSearchResponse": {
              "type": "object",
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CourseCard"
                  }
                },
                "pageInfo": {
                  "$ref": "#/components/schemas/PageInfo"
                }
              }
            },
            "CourseCard": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "title": {
                  "type": "string"
                },
                "shortDescription": {
                  "type": "string"
                },
                "authorName": {
                  "type": "string"
                },
                "rating": {
                  "type": "number"
                },
                "price": {
                  "type": "number"
                },
                "status": {
                  "type": "string"
                }
              }
            },
            "CourseDetail": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "title": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "rating": {
                  "type": "number"
                },
                "reviewsCount": {
                  "type": "integer"
                },
                "price": {
                  "type": "number"
                },
                "status": {
                  "type": "string"
                }
              }
            },
            "ReviewListResponse": {
              "type": "object",
              "properties": {
                "items": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Review"
                  }
                },
                "pageInfo": {
                  "$ref": "#/components/schemas/PageInfo"
                }
              }
            },
            "Review": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "rating": {
                  "type": "integer"
                },
                "text": {
                  "type": "string"
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "CreateReviewRequest": {
              "type": "object",
              "required": [
                "rating",
                "text"
              ],
              "properties": {
                "rating": {
                  "type": "integer"
                },
                "text": {
                  "type": "string"
                }
              }
            },
            "CreateEnrollmentRequest": {
              "type": "object",
              "required": [
                "courseId"
              ],
              "properties": {
                "courseId": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            },
            "Enrollment": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "courseId": {
                  "type": "string",
                  "format": "uuid"
                },
                "userId": {
                  "type": "string",
                  "format": "uuid"
                },
                "enrolledAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "CreateDraftRequest": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                }
              }
            },
            "DraftSummary": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "courseId": {
                  "type": "string",
                  "format": "uuid"
                },
                "title": {
                  "type": "string"
                }
              }
            },
            "DraftDetail": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "courseId": {
                  "type": "string",
                  "format": "uuid"
                },
                "title": {
                  "type": "string"
                },
                "status": {
                  "type": "string"
                },
                "materials": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Material"
                  }
                }
              }
            },
            "UpdateDraftRequest": {
              "type": "object",
              "properties": {
                "title": {
                  "type": "string"
                }
              }
            },
            "UploadMaterialRequest": {
              "type": "object",
              "required": [
                "file",
                "type",
                "title"
              ],
              "properties": {
                "file": {
                  "type": "string",
                  "format": "binary"
                },
                "type": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                }
              }
            },
            "Material": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid"
                },
                "title": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "fileUrl": {
                  "type": "string"
                }
              }
            },
            "GenerateDraftRequest": {
              "type": "object",
              "properties": {
                "prompt": {
                  "type": "string"
                }
              }
            },
            "GenerateDraftResponse": {
              "type": "object",
              "properties": {
                "draftId": {
                  "type": "string",
                  "format": "uuid"
                },
                "generatedText": {
                  "type": "string"
                }
              }
            },
            "PublishDraftResponse": {
              "type": "object",
              "properties": {
                "courseId": {
                  "type": "string",
                  "format": "uuid"
                },
                "draftId": {
                  "type": "string",
                  "format": "uuid"
                },
                "publishedAt": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            },
            "DraftHistoryGraph": {
              "type": "object",
              "properties": {
                "nodes": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                },
                "edges": {
                  "type": "array",
                  "items": {
                    "type": "object"
                  }
                }
              }
            },
            "PageInfo": {
              "type": "object",
              "properties": {
                "page": {
                  "type": "integer"
                },
                "pageSize": {
                  "type": "integer"
                },
                "totalItems": {
                  "type": "integer"
                },
                "totalPages": {
                  "type": "integer"
                }
              }
            }
          }
        }
      }
    }
  },
  "docusaurus-theme-redoc": {
    "theme-redoc": {
      "lightTheme": {
        "typography": {
          "fontFamily": "var(--ifm-font-family-base)",
          "fontSize": "var(--ifm-font-size-base)",
          "lineHeight": "var(--ifm-line-height-base)",
          "fontWeightLight": "var(--ifm-font-weight-light)",
          "fontWeightRegular": "var(--ifm-font-weight-base)",
          "fontWeightBold": "var(--ifm-font-weight-bold)",
          "headings": {
            "fontFamily": "var(--ifm-heading-font-family)",
            "fontWeight": "var(--ifm-heading-font-weight)",
            "lineHeight": "var(--ifm-heading-line-height)"
          },
          "code": {
            "fontFamily": "var(--ifm-font-family-monospace)",
            "lineHeight": "var(--ifm-pre-line-height)"
          }
        },
        "sidebar": {
          "width": "300px",
          "backgroundColor": "#ffffff"
        },
        "rightPanel": {
          "backgroundColor": "#303846"
        },
        "colors": {
          "primary": {
            "main": "#25c2a0"
          }
        },
        "theme": {
          "prism": {
            "additionalLanguages": [
              "scala"
            ]
          }
        }
      },
      "darkTheme": {
        "typography": {
          "fontFamily": "var(--ifm-font-family-base)",
          "fontSize": "var(--ifm-font-size-base)",
          "lineHeight": "var(--ifm-line-height-base)",
          "fontWeightLight": "var(--ifm-font-weight-light)",
          "fontWeightRegular": "var(--ifm-font-weight-base)",
          "fontWeightBold": "var(--ifm-font-weight-bold)",
          "headings": {
            "fontFamily": "var(--ifm-heading-font-family)",
            "fontWeight": "var(--ifm-heading-font-weight)",
            "lineHeight": "var(--ifm-heading-line-height)"
          },
          "code": {
            "fontFamily": "var(--ifm-font-family-monospace)",
            "lineHeight": "var(--ifm-pre-line-height)"
          }
        },
        "sidebar": {
          "width": "300px",
          "backgroundColor": "rgb(24, 25, 26)",
          "textColor": "#f5f6f7",
          "arrow": {
            "color": "#f5f6f7"
          }
        },
        "colors": {
          "text": {
            "primary": "#f5f6f7",
            "secondary": "rgba(255, 255, 255, 1)"
          },
          "gray": {
            "50": "#FAFAFA",
            "100": "#F5F5F5"
          },
          "border": {
            "dark": "#ffffff",
            "light": "rgba(0,0,0, 0.1)"
          },
          "primary": {
            "main": "#25c2a0"
          }
        },
        "schema": {
          "nestedBackground": "rgb(24, 25, 26)",
          "typeNameColor": "rgba(255, 255, 255, 1)",
          "typeTitleColor": "rgba(255, 255, 255, 1)"
        },
        "theme": {
          "prism": {
            "additionalLanguages": [
              "scala"
            ]
          }
        }
      },
      "options": {
        "scrollYOffset": "nav.navbar",
        "expandSingleSchemaField": true,
        "menuToggle": true,
        "suppressWarnings": true
      }
    }
  },
  "docusaurus-plugin-drawio": {
    "default": {
      "id": "default"
    }
  }
}